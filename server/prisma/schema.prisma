// Optional PostgreSQL model blueprint for expanding the demo beyond JSON storage.
// The running demo uses server/data/db.json for zero-setup local development.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(LEARNER)
  planId       String?
  joinedAt     DateTime      @default(now())
  lastActiveAt DateTime?
  progress     Progress[]
  attempts     QuizAttempt[]
  payments     Payment[]
}

model Course {
  id          String        @id @default(cuid())
  title       String
  description String
  duration    String
  difficulty  String
  level       String
  category    String
  chapters    Chapter[]
  progress    Progress[]
}

model Chapter {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  title    String
  duration String
  lessons  Lesson[]
  quizzes  Quiz[]
}

model Lesson {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])
  title     String
  type      String
  duration  String
  content   String
}

model Quiz {
  id        String         @id @default(cuid())
  chapterId String
  chapter   Chapter        @relation(fields: [chapterId], references: [id])
  title     String
  passMark  Int
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id          String @id @default(cuid())
  quizId      String
  quiz        Quiz   @relation(fields: [quizId], references: [id])
  prompt      String
  options     Json
  answerIndex Int
  explanation String
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  score     Int
  passed    Boolean
  answers   Json
  createdAt DateTime @default(now())
}

model Progress {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id])
  completedLessons Json
  completedQuizzes Json
  currentLessonId  String?
  enrolledAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PricingPlan {
  id       String    @id
  name     String
  price    Int
  cadence  String
  includes Json
  payments Payment[]
}

model CertificationTrack {
  id          String @id
  title       String
  vendor      String
  exam        String
  status      String
  progress    Int
  description String
}

model Payment {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  planId    String
  plan      PricingPlan @relation(fields: [planId], references: [id])
  amount    Int
  status    String
  provider  String
  paidAt    DateTime
}

enum Role {
  LEARNER
  ADMIN
}
